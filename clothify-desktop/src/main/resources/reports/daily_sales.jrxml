<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="daily_sales" pageWidth="555" pageHeight="100" columnWidth="555">
    <field name="saleDate" class="java.lang.String"/>
    <field name="orderCount" class="java.lang.Integer"/>
    <field name="revenue" class="java.lang.Double"/>
    <columnHeader>
        <band height="16">
            <staticText><reportElement x="0" y="0" width="200" height="14"/><text><![CDATA[Date]]></text></staticText>
            <staticText><reportElement x="200" y="0" width="150" height="14"/><text><![CDATA[Orders]]></text></staticText>
            <staticText><reportElement x="350" y="0" width="150" height="14"/><text><![CDATA[Revenue]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="14">
            <textField><reportElement x="0" y="0" width="200" height="14"/><textFieldExpression><![CDATA[$F{saleDate}]]></textFieldExpression></textField>
            <textField><reportElement x="200" y="0" width="150" height="14"/><textFieldExpression><![CDATA[$F{orderCount}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="0" width="150" height="14"/><textFieldExpression><![CDATA[$F{revenue}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
