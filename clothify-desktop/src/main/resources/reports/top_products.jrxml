<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="top_products" pageWidth="555" pageHeight="120" columnWidth="555">
    <field name="productName" class="java.lang.String"/>
    <field name="totalQtySold" class="java.lang.Integer"/>
    <field name="totalRevenue" class="java.lang.Double"/>
    <columnHeader>
        <band height="16">
            <staticText><reportElement x="0" y="0" width="250" height="14"/><text><![CDATA[Product]]></text></staticText>
            <staticText><reportElement x="250" y="0" width="100" height="14"/><text><![CDATA[Qty Sold]]></text></staticText>
            <staticText><reportElement x="350" y="0" width="150" height="14"/><text><![CDATA[Revenue]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="14">
            <textField><reportElement x="0" y="0" width="250" height="14"/><textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression></textField>
            <textField><reportElement x="250" y="0" width="100" height="14"/><textFieldExpression><![CDATA[$F{totalQtySold}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="0" width="150" height="14"/><textFieldExpression><![CDATA[$F{totalRevenue}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
