<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="pageRoot" spacing="16.0" styleClass="content-page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.category.CategoryController">
   <children>
      <Label styleClass="page-title-label" text="Category Management" />
      <HBox spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox minWidth="340.0" prefWidth="360.0" spacing="12.0" styleClass="card">
               <children>
                  <Label styleClass="section-title" text="Category Form" />
                  <Label styleClass="muted-label" text="ID" />
                  <TextField fx:id="txtId" editable="false" styleClass="modern-input field-locked id-field" />
                  <TextField fx:id="txtName" promptText="Category Name" styleClass="modern-input" />
                  <TextArea fx:id="txtDescription" prefHeight="80.0" promptText="Description" styleClass="modern-input" wrapText="true" />
                  <GridPane hgap="8.0" styleClass="action-bar" vgap="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnAdd" styleClass="add-btn" text="Add" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnUpdate" styleClass="update-btn" text="Update" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnDelete" styleClass="delete-btn" text="Delete" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnClear" styleClass="clear-btn" text="Clear" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />
                     </children>
                     <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                     </columnConstraints>
                  </GridPane>
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="section-title" text="Categories" />
                  <TableView fx:id="tblCategory" prefHeight="420.0" styleClass="product-table" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="200.0" text="Name" />
                        <TableColumn fx:id="colDescription" prefWidth="460.0" text="Description" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
