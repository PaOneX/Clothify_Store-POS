<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="pageRoot" spacing="16.0" styleClass="content-page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.inventory.InventoryController">
   <children>
      <Label styleClass="page-title-label" text="Inventory Management" />
      <HBox spacing="16.0">
         <children>
            <VBox spacing="6.0" styleClass="stat-card stock-stat-good">
               <children>
                  <Label styleClass="stat-card-title" text="🟢 Good Stock" />
                  <Label fx:id="lblGoodCount" styleClass="stat-card-value" text="0" />
               </children>
            </VBox>
            <VBox spacing="6.0" styleClass="stat-card stock-stat-low">
               <children>
                  <Label styleClass="stat-card-title" text="🟡 Low Stock" />
                  <Label fx:id="lblLowCount" styleClass="stat-card-value" text="0" />
               </children>
            </VBox>
            <VBox spacing="6.0" styleClass="stat-card stock-stat-out">
               <children>
                  <Label styleClass="stat-card-title" text="🔴 Out of Stock" />
                  <Label fx:id="lblOutCount" styleClass="stat-card-value" text="0" />
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <TextField fx:id="txtSearch" promptText="Search product, SKU, supplier..." styleClass="modern-input" HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#btnSearch" styleClass="nav-btn" text="Search" />
               </children>
            </HBox>
            <TableView fx:id="tblInventory" prefHeight="400.0" styleClass="product-table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="50.0" text="Var ID" />
                  <TableColumn fx:id="colName" prefWidth="180.0" text="Product" />
                  <TableColumn fx:id="colSize" prefWidth="60.0" text="Size" />
                  <TableColumn fx:id="colQty" prefWidth="60.0" text="Qty" />
                  <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="colCategory" prefWidth="120.0" text="Category" />
                  <TableColumn fx:id="colSupplier" prefWidth="140.0" text="Supplier" />
               </columns>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label fx:id="lblSupplierDetail" styleClass="muted-label" text="Select a row to view supplier details" wrapText="true" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox spacing="8.0">
               <children>
                  <TextField fx:id="txtAdjustQty" prefWidth="100.0" promptText="Qty" styleClass="modern-input" />
                  <ComboBox fx:id="cmbReason" prefWidth="130.0" styleClass="modern-input" />
                  <Button mnemonicParsing="false" onAction="#btnStockIn" styleClass="add-btn" text="Stock In" />
                  <Button mnemonicParsing="false" onAction="#btnStockOut" styleClass="delete-btn" text="Stock Out" />
                  <Button mnemonicParsing="false" onAction="#btnRefresh" styleClass="nav-btn" text="Refresh" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
