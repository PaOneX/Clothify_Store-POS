<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="content-page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.settings.SettingsController">
   <children>
      <Label styleClass="page-title-label" text="Settings" />
      <Label styleClass="muted-label" text="Application configuration (read from db.properties)" />
      <VBox spacing="12.0" styleClass="card">
         <children>
            <Label styleClass="section-title" text="Store" />
            <GridPane hgap="16.0" vgap="10.0">
               <children>
                  <Label text="Store Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <Label fx:id="lblStoreName" styleClass="cart-summary-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Tax Rate:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <Label fx:id="lblTaxRate" styleClass="cart-summary-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Low Stock Threshold:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <Label fx:id="lblLowStock" styleClass="cart-summary-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Session Timeout (min):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <Label fx:id="lblSessionTimeout" styleClass="cart-summary-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="Backup Directory:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                  <Label fx:id="lblBackupDir" styleClass="cart-summary-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               </children>
            </GridPane>
         </children>
      </VBox>
   </children>
</VBox>
