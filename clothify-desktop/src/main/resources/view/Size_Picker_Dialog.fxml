<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="dialogRoot" prefWidth="420.0" spacing="14.0" styleClass="card" stylesheets="@../css/Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.order.SizePickerDialogController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <ImageView fx:id="imgProduct" fitHeight="72.0" fitWidth="72.0" preserveRatio="true" styleClass="image-preview" />
         <VBox spacing="4.0">
            <Label fx:id="lblProductName" styleClass="page-title-label" wrapText="true" />
            <Label fx:id="lblPrice" styleClass="product-card-price" />
         </VBox>
      </HBox>
      <Label styleClass="section-title" text="Select size" />
      <FlowPane fx:id="sizeButtonPane" hgap="8.0" vgap="8.0" />
      <Label fx:id="lblSizeInfo" styleClass="muted-label" wrapText="true" />
      <HBox alignment="CENTER_RIGHT" spacing="8.0">
         <Button cancelButton="true" onAction="#btnCancel" styleClass="clear-btn" text="Cancel" />
         <Button defaultButton="true" fx:id="btnAdd" onAction="#btnAdd" styleClass="add-btn" text="Add to Cart" />
      </HBox>
   </children>
</VBox>
