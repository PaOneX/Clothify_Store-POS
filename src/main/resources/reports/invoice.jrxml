<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="invoice" pageWidth="226" pageHeight="842" columnWidth="186" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="storeName" class="java.lang.String"/>
    <parameter name="invoiceNo" class="java.lang.String"/>
    <parameter name="invoiceDate" class="java.lang.String"/>
    <parameter name="cashier" class="java.lang.String"/>
    <parameter name="subtotal" class="java.lang.String"/>
    <parameter name="discount" class="java.lang.String"/>
    <parameter name="tax" class="java.lang.String"/>
    <parameter name="total" class="java.lang.String"/>
    <parameter name="customer" class="java.lang.String"/>
    <parameter name="payment" class="java.lang.String"/>
    <field name="productName" class="java.lang.String"/>
    <field name="qty" class="java.lang.Integer"/>
    <field name="unitPrice" class="java.lang.Double"/>
    <field name="lineTotal" class="java.lang.Double"/>
    <title>
        <band height="104">
            <staticText>
                <reportElement x="0" y="0" width="186" height="20"/>
                <textElement textAlignment="Center"><font size="14" isBold="true"/></textElement>
                <text><![CDATA[INVOICE]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="22" width="186" height="16"/>
                <textElement textAlignment="Center"><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{storeName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="42" width="186" height="14"/>
                <textFieldExpression><![CDATA["No: " + $P{invoiceNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="56" width="186" height="14"/>
                <textFieldExpression><![CDATA["Date: " + $P{invoiceDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="70" width="186" height="14"/>
                <textFieldExpression><![CDATA["Cashier: " + $P{cashier}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="84" width="186" height="14"/>
                <textFieldExpression><![CDATA["Customer: " + $P{customer}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="18">
            <staticText><reportElement x="0" y="0" width="80" height="14"/><text><![CDATA[Item]]></text></staticText>
            <staticText><reportElement x="80" y="0" width="26" height="14"/><text><![CDATA[Qty]]></text></staticText>
            <staticText><reportElement x="106" y="0" width="40" height="14"/><text><![CDATA[Price]]></text></staticText>
            <staticText><reportElement x="146" y="0" width="40" height="14"/><text><![CDATA[Total]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="16">
            <textField><reportElement x="0" y="0" width="80" height="14"/><textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression></textField>
            <textField><reportElement x="80" y="0" width="26" height="14"/><textFieldExpression><![CDATA[$F{qty}]]></textFieldExpression></textField>
            <textField><reportElement x="106" y="0" width="40" height="14"/><textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression></textField>
            <textField><reportElement x="146" y="0" width="40" height="14"/><textFieldExpression><![CDATA[$F{lineTotal}]]></textFieldExpression></textField>
        </band>
    </detail>
    <summary>
        <band height="88">
            <textField><reportElement x="0" y="0" width="186" height="14"/><textFieldExpression><![CDATA["Subtotal: " + $P{subtotal}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="14" width="186" height="14"/><textFieldExpression><![CDATA["Discount: " + $P{discount}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="28" width="186" height="14"/><textFieldExpression><![CDATA["Tax: " + $P{tax}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="44" width="186" height="16"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA["TOTAL: " + $P{total}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="62" width="186" height="14"/><textFieldExpression><![CDATA["Payment: " + $P{payment}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="78" width="186" height="10"/><textElement textAlignment="Center"><font size="8"/></textElement><text><![CDATA[Thank you for shopping!]]></text></staticText>
        </band>
    </summary>
</jasperReport>
