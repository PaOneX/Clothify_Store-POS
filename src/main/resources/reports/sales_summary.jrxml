<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sales_summary" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="storeName" class="java.lang.String"/>
    <parameter name="dateFrom" class="java.lang.String"/>
    <parameter name="dateTo" class="java.lang.String"/>
    <parameter name="orderCount" class="java.lang.String"/>
    <parameter name="totalRevenue" class="java.lang.String"/>
    <parameter name="totalTax" class="java.lang.String"/>
    <parameter name="topProductsReport" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="dailySalesReport" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="topProducts" class="net.sf.jasperreports.engine.data.JRBeanCollectionDataSource"/>
    <parameter name="dailySales" class="net.sf.jasperreports.engine.data.JRBeanCollectionDataSource"/>
    <title>
        <band height="80">
            <staticText><reportElement x="0" y="0" width="555" height="24"/><textElement textAlignment="Center"><font size="18" isBold="true"/></textElement><text><![CDATA[Sales Report]]></text></staticText>
            <textField><reportElement x="0" y="28" width="555" height="16"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{storeName}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="46" width="555" height="14"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA["Period: " + $P{dateFrom} + " to " + $P{dateTo}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="62" width="555" height="14"/><textFieldExpression><![CDATA["Orders: " + $P{orderCount} + "  |  Revenue: " + $P{totalRevenue} + "  |  Tax: " + $P{totalTax}]]></textFieldExpression></textField>
        </band>
    </title>
    <summary>
        <band height="280">
            <staticText><reportElement x="0" y="0" width="200" height="16"/><textElement><font isBold="true"/></textElement><text><![CDATA[Top Products]]></text></staticText>
            <subreport>
                <reportElement x="0" y="20" width="555" height="120"/>
                <dataSourceExpression><![CDATA[$P{topProducts}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{topProductsReport}]]></subreportExpression>
            </subreport>
            <staticText><reportElement x="0" y="150" width="200" height="16"/><textElement><font isBold="true"/></textElement><text><![CDATA[Daily Sales]]></text></staticText>
            <subreport>
                <reportElement x="0" y="170" width="555" height="100"/>
                <dataSourceExpression><![CDATA[$P{dailySales}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{dailySalesReport}]]></subreportExpression>
            </subreport>
        </band>
    </summary>
</jasperReport>
