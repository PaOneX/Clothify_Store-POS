<?xml version="1.0" encoding="UTF-8"?>



<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.TableColumn?>

<?import javafx.scene.control.TableView?>

<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.VBox?>



<VBox fx:id="rootPane" alignment="TOP_CENTER" prefHeight="520.0" prefWidth="480.0" spacing="12.0" styleClass="invoice-pane" stylesheets="@../css/Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.order.InvoicePreviewController">

   <children>

      <Label fx:id="lblStoreName" styleClass="page-title-label" text="Clothify Store" />

      <Label fx:id="lblInvoiceNo" text="Invoice:" />

      <Label fx:id="lblDate" text="Date:" />

      <Label fx:id="lblCashier" text="Cashier:" />
      <Label fx:id="lblCustomer" text="Customer:" />
      <Label fx:id="lblPayment" text="Payment:" />

      <TableView fx:id="tblItems" prefHeight="250.0" prefWidth="440.0" styleClass="product-table">

         <columns>

            <TableColumn fx:id="colItemName" prefWidth="200.0" text="Product" />

            <TableColumn fx:id="colItemQty" prefWidth="50.0" text="Qty" />

            <TableColumn fx:id="colItemPrice" prefWidth="80.0" text="Price" />

            <TableColumn fx:id="colItemTotal" prefWidth="90.0" text="Total" />

         </columns>

      </TableView>

      <Label fx:id="lblSubtotal" text="Subtotal:" />

      <Label fx:id="lblDiscount" text="Discount:" />

      <Label fx:id="lblTax" text="Tax:" />

      <Label fx:id="lblTotal" styleClass="invoice-total" text="Total:" />

      <HBox alignment="CENTER" spacing="12.0">

         <children>

            <Button onAction="#btnPrint" prefHeight="38.0" prefWidth="130.0" styleClass="nav-btn" text="Print" />

            <Button onAction="#btnClose" prefHeight="38.0" prefWidth="130.0" styleClass="clear-btn" text="Close" />

         </children>

      </HBox>

   </children>

</VBox>

