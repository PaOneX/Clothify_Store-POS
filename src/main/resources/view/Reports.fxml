<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="pageRoot" spacing="16.0" styleClass="content-page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.report.ReportController">
   <children>
      <Label styleClass="page-title-label" text="Reports &amp; Analytics" />
      <HBox spacing="12.0">
         <DatePicker fx:id="dpFrom" styleClass="modern-input" />
         <DatePicker fx:id="dpTo" styleClass="modern-input" />
         <Button onAction="#btnGenerate" styleClass="nav-btn" text="Refresh" />
         <Button onAction="#btnGenerateReport" styleClass="add-btn" text="Print PDF" />
         <Button onAction="#btnExportPdf" styleClass="info-btn" text="Save PDF" />
         <Button onAction="#btnExportCsv" styleClass="info-btn" text="Export CSV" />
         <Button onAction="#btnBackup" styleClass="clear-btn" text="Backup DB" />
         <Button onAction="#btnRestore" styleClass="delete-btn" text="Restore" />
      </HBox>
      <HBox spacing="16.0">
         <VBox spacing="6.0" styleClass="stat-card"><Label styleClass="stat-card-title" text="Orders" /><Label fx:id="lblOrderCount" styleClass="stat-card-value" text="0" /></VBox>
         <VBox spacing="6.0" styleClass="stat-card"><Label styleClass="stat-card-title" text="Revenue" /><Label fx:id="lblRevenue" styleClass="stat-card-value" text="Rs. 0" /></VBox>
         <VBox spacing="6.0" styleClass="stat-card"><Label styleClass="stat-card-title" text="Tax" /><Label fx:id="lblTax" styleClass="stat-card-value" text="Rs. 0" /></VBox>
         <VBox spacing="6.0" styleClass="stat-card"><Label styleClass="stat-card-title" text="Profit" /><Label fx:id="lblProfit" styleClass="stat-card-value" text="Rs. 0" /></VBox>
         <VBox spacing="6.0" styleClass="stat-card"><Label styleClass="stat-card-title" text="Low Stock" /><Label fx:id="lblLowStock" styleClass="stat-card-value" text="0" /></VBox>
         <VBox spacing="6.0" styleClass="stat-card"><Label styleClass="stat-card-title" text="SKUs" /><Label fx:id="lblSkus" styleClass="stat-card-value" text="0" /></VBox>
         <VBox spacing="6.0" styleClass="stat-card"><Label styleClass="stat-card-title" text="Units" /><Label fx:id="lblUnits" styleClass="stat-card-value" text="0" /></VBox>
      </HBox>
      <VBox fx:id="chartContainer" spacing="8.0" styleClass="card" />
      <HBox spacing="16.0" VBox.vgrow="ALWAYS">
         <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Top Products" />
            <TableView fx:id="tblTopProducts" prefHeight="180.0" styleClass="product-table">
               <columns>
                  <TableColumn fx:id="colTopName" prefWidth="200.0" text="Product" />
                  <TableColumn fx:id="colTopQty" prefWidth="80.0" text="Qty" />
                  <TableColumn fx:id="colTopRevenue" prefWidth="100.0" text="Revenue" />
               </columns>
            </TableView>
         </VBox>
         <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Daily Sales" />
            <TableView fx:id="tblDailySales" prefHeight="180.0" styleClass="product-table">
               <columns>
                  <TableColumn fx:id="colDailyDate" prefWidth="120.0" text="Date" />
                  <TableColumn fx:id="colDailyOrders" prefWidth="70.0" text="Orders" />
                  <TableColumn fx:id="colDailyRevenue" prefWidth="100.0" text="Revenue" />
               </columns>
            </TableView>
         </VBox>
         <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Slow Movers (30d)" />
            <TableView fx:id="tblSlowMoving" prefHeight="180.0" styleClass="product-table">
               <columns>
                  <TableColumn fx:id="colSlowName" prefWidth="160.0" text="Product" />
                  <TableColumn fx:id="colSlowDays" prefWidth="70.0" text="Days" />
                  <TableColumn fx:id="colSlowQty" prefWidth="60.0" text="Stock" />
               </columns>
            </TableView>
         </VBox>
      </HBox>
      <VBox spacing="8.0" styleClass="card" VBox.vgrow="ALWAYS">
         <Label styleClass="section-title" text="Orders (double-click to reprint)" />
         <HBox spacing="8.0">
            <TextField fx:id="txtOrderId" prefWidth="120.0" promptText="Order ID" styleClass="modern-input" />
            <Button onAction="#btnSearchOrders" styleClass="nav-btn" text="Search" />
         </HBox>
         <TableView fx:id="tblOrders" prefHeight="200.0" styleClass="product-table" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colOrderId" prefWidth="80.0" text="ID" />
               <TableColumn fx:id="colOrderDate" prefWidth="180.0" text="Date" />
               <TableColumn fx:id="colCashier" prefWidth="150.0" text="Cashier" />
               <TableColumn fx:id="colOrderTotal" prefWidth="120.0" text="Total" />
            </columns>
         </TableView>
      </VBox>
   </children>
</VBox>
